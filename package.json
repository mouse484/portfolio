  "dependencies": {
    "@iconify/svelte": "^5.2.2",
    "motion": "^13.2.0",
    "the-new-css-reset": "^1.11.3"
  },
  "devDependencies": {
    "@mouse_484/eslint-config": "5.11.15",
    "@mouse_484/stylelint-config": "1.1.16",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "eslint": "10.9.1",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-svelte": "3.23.0",
    "stylelint": "17.14.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  }
