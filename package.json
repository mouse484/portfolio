{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.23.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:css": "stylelint '**/*.{svelte,css}'",
    "generate:css": "npx tsx script/theme/generate.ts > src/lib/styles/theme.css"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.4",
    "motion": "^14.14.0",
    "the-new-css-reset": "^1.11.3"
  },
  "devDependencies": {
    "@mouse_484/eslint-config": "5.11.41",
    "@mouse_484/stylelint-config": "2.0.2",
    "@sveltejs/adapter-cloudflare": "8.0.4",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "eslint": "10.15.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-svelte": "3.24.1",
    "stylelint": "18.1.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.12.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  }
}
